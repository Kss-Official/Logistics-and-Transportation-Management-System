        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{--pr-bg:#f5f8fc;--pr-ink:#0f172a;--pr-muted:#64748b;--pr-line:#e2e8f0;--pr-blue:#2563eb;--role-customer:#f97316;--role-admin:#6d3df5;--role-warehouse:#10b981;--role-driver:#2563eb}\n.pr-auth-page{font-family:Inter,system-ui,sans-serif;background:radial-gradient(ellipse at 94% 13%,rgba(219,234,254,.48),transparent 30%),radial-gradient(ellipse at 5% 78%,rgba(255,247,237,.54),transparent 27%),#f3f7fc;color:var(--pr-ink);position:relative;isolation:isolate;overflow:hidden}\n.pr-auth-page:before{content:\"\";position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(rgba(59,130,246,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(59,130,246,.045) 1px,transparent 1px);background-size:52px 52px}\n.pr-auth-page>header,.pr-auth-page>main,.pr-auth-page>footer{position:relative;z-index:1}\n.signin-float-layer{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}\n.signin-float{position:absolute;display:block;overflow:hidden;border:2px solid rgba(255,255,255,.82);border-radius:14px;opacity:.28;box-shadow:0 8px 22px rgba(15,23,42,.12);will-change:transform}\n.signin-float img{display:block;width:100%;height:100%;object-fit:cover}\n.signin-float--truck{left:-58px;top:29%;width:132px;height:86px;transform:rotate(-8deg)}\n.signin-float--warehouse{right:-62px;bottom:18%;width:142px;height:94px;transform:rotate(7deg)}\n@media(max-width:768px){.signin-float-layer{display:none}}\n.pr-auth-header{max-width:1280px;margin:0 auto;padding:25px 38px;display:flex;align-items:center;justify-content:space-between;gap:24px}\n.pr-auth-brand{display:flex;align-items:center;gap:12px}\n.pr-auth-logo{width:42px;height:42px;border-radius:12px;background:linear-gradient(145deg,#2563eb,#1d4ed8);display:flex;align-items:center;justify-content:center;color:white;font-size:16px;font-weight:800;letter-spacing:-.04em;box-shadow:0 5px 12px rgba(37,99,235,.22)}\n.pr-auth-brand-name{font-size:18px;font-weight:800;line-height:1.1;letter-spacing:-.03em}\n.pr-auth-brand-tag{margin-top:3px;font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--pr-blue)}\n.pr-auth-tagline{margin-top:7px;font-size:12px;color:#64748b}\n.pr-auth-home{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border:1px solid #d7e0eb;border-radius:9px;background:rgba(255,255,255,.72);color:#334155;font-size:13px;font-weight:600;text-decoration:none;transition:background .18s,border-color .18s,color .18s}\n.pr-auth-home:hover{background:white;border-color:#b8c7d9;color:#0f172a}\n.pr-auth-home:focus-visible,.pr-login-link:focus-visible,.pr-role-row:focus-visible,.pr-create:focus-visible{outline:3px solid rgba(37,99,235,.28);outline-offset:3px}\n.pr-auth-main{width:min(1280px,100%);margin:0 auto;padding:28px 38px 26px}\n.pr-auth-intro{margin:0 0 27px;max-width:690px}\n.pr-auth-intro h1{margin:0;color:#0f172a;font-size:clamp(32px,3.1vw,43px);font-weight:750;letter-spacing:-.045em;line-height:1.13}\n.pr-auth-intro p{margin:12px 0 0;color:#526174;font-size:16px;line-height:1.65}\n.pr-access-grid{display:grid;grid-template-columns:minmax(330px,.88fr) minmax(0,1.52fr);gap:22px;align-items:stretch}\n.pr-zone{min-width:0;background:#fff;border:1px solid #e1e8f0;border-radius:18px;box-shadow:0 10px 30px rgba(15,23,42,.035)}\n.pr-customer-zone{display:flex;flex-direction:column;padding:29px 30px 24px;min-height:458px;position:relative;overflow:hidden}\n.pr-customer-zone:before{content:'';position:absolute;right:-65px;top:-86px;width:205px;height:205px;border-radius:50%;background:radial-gradient(circle,rgba(249,115,22,.1),rgba(249,115,22,0) 68%);pointer-events:none}\n.pr-zone-heading{position:relative;display:flex;align-items:center;gap:13px}\n.pr-role-glyph{display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;width:27px;height:27px;font-size:23px;line-height:1}\n.pr-zone-heading h2{margin:0;font-size:24px;line-height:1.2;letter-spacing:-.03em;font-weight:700}\n.pr-zone-subtitle{margin:9px 0 0;color:#64748b;font-size:13.5px;line-height:1.55}\n.pr-customer-copy{margin-top:32px}\n.pr-customer-copy h3{margin:0 0 9px;font-size:17px;line-height:1.35;letter-spacing:-.02em;font-weight:650;color:#172033}\n.pr-customer-copy p{margin:0;color:#59687b;font-size:14px;line-height:1.7;max-width:310px}\n.pr-customer-taskline{display:flex;flex-wrap:wrap;gap:8px 13px;margin:21px 0 0;padding:0;list-style:none;color:#465569;font-size:12.5px}\n.pr-customer-taskline li{display:inline-flex;align-items:center;gap:7px;white-space:nowrap}\n.pr-customer-taskline li:before{content:'';width:5px;height:5px;border-radius:50%;background:var(--role-customer);flex:0 0 auto}\n.pr-customer-actions{margin-top:auto;padding-top:32px}\n.pr-login-link{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;padding:14px 18px;border-radius:10px;background:var(--role-customer);color:white;text-decoration:none;font-size:14px;font-weight:700;box-shadow:0 4px 10px rgba(249,115,22,.17);transition:background .18s,transform .18s,box-shadow .18s}\n.pr-login-link:hover{background:#ea580c;transform:translateY(-1px);box-shadow:0 7px 15px rgba(249,115,22,.22)}\n.pr-login-link i{width:18px;height:18px;font-size:17px;color:white}\n.pr-create-wrap{margin-top:17px;text-align:center;color:#728094;font-size:12.5px}\n.pr-create{display:inline-block;margin-top:5px;color:#1d4ed8;font-size:13px;font-weight:650;text-decoration:none}\n.pr-create:hover{text-decoration:underline}\n.pr-operations-zone{display:grid;grid-template-columns:minmax(0,1fr) 35%;min-height:458px;overflow:hidden}\n.pr-operations-copy{padding:27px 27px 18px 30px;min-width:0}\n.pr-operations-copy h2{margin:0;font-size:21px;line-height:1.25;letter-spacing:-.03em;font-weight:700}\n.pr-operations-copy>p{margin:7px 0 13px;color:#67768a;font-size:13px;line-height:1.55}\n.pr-role-list{display:flex;flex-direction:column}\n.pr-role-row{min-height:105px;display:grid;grid-template-columns:30px minmax(0,1fr) auto;align-items:center;gap:13px;padding:14px 0;border-bottom:1px solid #edf1f5;color:inherit;text-decoration:none;transition:background .16s}\n.pr-role-row:last-child{border-bottom:0}\n.pr-role-row:hover .pr-role-action{color:var(--role-accent);gap:9px}\n.pr-role-row:hover .pr-role-name{color:var(--role-accent)}\n.pr-role-row .pr-role-glyph{width:25px;height:25px;font-size:21px;color:var(--role-accent)}\n.pr-role-detail{min-width:0}\n.pr-role-name{margin:0;font-size:15px;line-height:1.3;font-weight:700;letter-spacing:-.01em;transition:color .16s}\n.pr-role-tasks{margin:5px 0 0;color:#69778a;font-size:12px;line-height:1.45}\n.pr-role-action{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;color:#334155;font-size:12px;font-weight:650;transition:color .16s,gap .16s}\n.pr-role-action i{width:16px;height:16px;font-size:15px;color:currentColor}\n.pr-ops-photo{height:100%;min-height:458px;position:relative;background:#d9e2ea}\n.pr-ops-photo img{display:block;width:100%;height:100%;min-height:458px;object-fit:cover;object-position:48% center}\n.pr-ops-photo:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(15,23,42,.08),transparent 36%),linear-gradient(0deg,rgba(15,23,42,.12),transparent 38%);pointer-events:none}\n.pr-auth-footer{max-width:1280px;margin:0 auto;padding:17px 38px 24px;display:flex;justify-content:space-between;align-items:center;gap:20px;color:#7b8796;font-size:11.5px}\n.pr-auth-footer strong{font-weight:600;color:#526174}\n@media(max-width:980px){.pr-auth-header,.pr-auth-main,.pr-auth-footer{padding-left:25px;padding-right:25px}.pr-access-grid{grid-template-columns:1fr;gap:16px}.pr-customer-zone{min-height:auto}.pr-customer-actions{margin-top:28px;padding-top:0}.pr-operations-zone{min-height:390px;grid-template-columns:minmax(0,1fr) 32%}.pr-ops-photo,.pr-ops-photo img{min-height:390px}}\n@media(max-width:640px){.pr-auth-header{padding:19px 19px 12px}.pr-auth-tagline{display:none}.pr-auth-home{padding:9px 10px;font-size:12px}.pr-auth-main{padding:27px 19px 20px}.pr-auth-intro{margin-bottom:20px}.pr-auth-intro h1{font-size:32px;line-height:1.15}.pr-auth-intro p{font-size:14px;margin-top:8px}.pr-customer-zone{padding:23px 21px 20px;border-radius:15px}.pr-customer-copy{margin-top:24px}.pr-customer-taskline{gap:8px 12px;margin-top:16px}.pr-customer-actions{margin-top:23px}.pr-operations-zone{grid-template-columns:1fr;min-height:auto;border-radius:15px}.pr-operations-copy{padding:23px 21px 10px}.pr-role-row{min-height:91px;grid-template-columns:27px minmax(0,1fr) auto;gap:10px}.pr-role-action{font-size:11.5px}.pr-role-tasks{font-size:11.7px}.pr-ops-photo{min-height:142px;height:142px;border-top:1px solid #edf1f5}.pr-ops-photo img{min-height:142px;height:142px;object-position:center 53%}.pr-auth-footer{padding:14px 19px 20px;flex-direction:column;align-items:flex-start;gap:5px}}\n@media(max-width:390px){.pr-auth-brand-name{font-size:16px}.pr-auth-home{gap:5px;padding:8px}.pr-role-action span{display:none}.pr-role-row{grid-template-columns:27px minmax(0,1fr) 16px}.pr-role-action{font-size:0}.pr-role-action i{font-size:16px}.pr-customer-taskline{font-size:11.5px}}\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    (() => {\n  if (!window.gsap) return;\n  const motion = gsap.matchMedia();\n  motion.add(\"(prefers-reduced-motion: no-preference)\", () => {\n    gsap.to(\".signin-float--truck\", { x: 22, y: -12, rotation: -3, duration: 13, ease: \"sine.inOut\", repeat: -1, yoyo: true });\n    gsap.to(\".signin-float--warehouse\", { x: -20, y: 12, rotation: 4, duration: 16, ease: \"sine.inOut\", repeat: -1, yoyo: true });\n  });\n})();\n</script>\n<div class=\"pr-auth-page min-h-screen flex flex-col\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"signin-float-layer\" data-kid=\"1-4\" data-name=\"floating decorative images container\">\n        <div class=\"signin-float signin-float--truck\" data-dynamic=\"true\" data-kid=\"1-4-1\" data-name=\"truck image floating container\" data-reason=\"position and rotation animated by GSAP\">\n            <img alt=\"\" data-kid=\"1-4-1-1\" data-name=\"truck float image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero_real_highway_truck.jpg\"/>\n        </div>\n        <div class=\"signin-float signin-float--warehouse\" data-dynamic=\"true\" data-kid=\"1-4-2\" data-name=\"warehouse image floating container\" data-reason=\"position and rotation animated by GSAP\">\n            <img alt=\"\" data-kid=\"1-4-2-1\" data-name=\"warehouse float image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/cargo_warehouse_terminal.jpg\"/>\n        </div>\n    </div>\n    <header class=\"pr-auth-header w-full\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <a aria-label=\"PrimeRoute Logistics home\" class=\"pr-auth-brand\" data-kid=\"1-1-1\" data-name=\"brand identity logo and name link\" href=\"/\">\n            <span class=\"pr-auth-logo\" data-kid=\"1-1-1-1\" data-name=\"brand logo icon\">\n                PR\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand name and tagline text container\">\n                <span class=\"pr-auth-brand-name block\" data-kid=\"1-1-1-2-1\" data-name=\"brand name primary text\">\n                    PrimeRoute\n                </span>\n                <span class=\"pr-auth-brand-tag block\" data-kid=\"1-1-1-2-2\" data-name=\"brand department label text\">\n                    Logistics\n                </span>\n                <span class=\"pr-auth-tagline block\" data-kid=\"1-1-1-2-3\" data-name=\"brand tagline descriptive text\">\n                    Connected Logistics. Smarter Tomorrow.\n                </span>\n            </span>\n        </a>\n        <a class=\"pr-auth-home\" data-kid=\"1-1-2\" data-name=\"back to home navigation link\" href=\"/\">\n            <i aria-hidden=\"true\" class=\"icon-arrow-left\" data-kid=\"1-1-2-1\" data-name=\"left arrow navigation icon\" style=\"width:16px;height:16px;font-size:15px;color:#334155\">\n            </i>\n            <span data-kid=\"1-1-2-2\" data-name=\"back to home text label\">\n                Back to Home\n            </span>\n        </a>\n    </header>\n    <main class=\"pr-auth-main flex-1\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"pr-auth-intro\" data-kid=\"1-2-1\" data-name=\"page introductory section\">\n            <h1 data-kid=\"1-2-1-1\" data-name=\"page main headline\">\n                Access your PrimeRoute workspace.\n            </h1>\n            <p data-kid=\"1-2-1-2\" data-name=\"page subheadline instruction\">\n                Choose the workspace for your role to continue.\n            </p>\n        </div>\n        <div class=\"pr-access-grid\" data-kid=\"1-2-2\" data-name=\"access portals grid container\">\n            <section aria-labelledby=\"customer-heading\" class=\"pr-zone pr-customer-zone\" data-kid=\"1-2-2-1\" data-name=\"customer access zone section\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"customer zone header container\">\n                    <div class=\"pr-zone-heading\" data-kid=\"1-2-2-1-1-1\" data-name=\"customer zone heading container\">\n                        <i aria-hidden=\"true\" class=\"pr-role-glyph icon-package\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"customer role symbol icon\" style=\"color:var(--role-customer);width:27px;height:27px;font-size:23px\">\n                        </i>\n                        <h2 data-kid=\"1-2-2-1-1-1-2\" data-name=\"customer portal title\" id=\"customer-heading\">\n                            Customer\n                        </h2>\n                    </div>\n                    <p class=\"pr-zone-subtitle\" data-kid=\"1-2-2-1-1-2\" data-name=\"customer zone subtitle description\">\n                        For customers booking and managing shipments.\n                    </p>\n                </div>\n                <div class=\"pr-customer-copy\" data-kid=\"1-2-2-1-2\" data-name=\"customer benefits details container\">\n                    <h3 data-kid=\"1-2-2-1-2-1\" data-name=\"customer benefits section title\">\n                        Keep your shipments moving.\n                    </h3>\n                    <p data-kid=\"1-2-2-1-2-2\" data-name=\"customer benefits description\">\n                        Book shipments, track orders, and manage deliveries from one place.\n                    </p>\n                    <ul aria-label=\"Customer portal capabilities\" class=\"pr-customer-taskline\" data-kid=\"1-2-2-1-2-3\" data-name=\"customer capabilities task list\">\n                        <li data-kid=\"1-2-2-1-2-3-1\" data-name=\"customer task item 1\">\n                            Book shipments\n                        </li>\n                        <li data-kid=\"1-2-2-1-2-3-2\" data-name=\"customer task item 2\">\n                            Track orders\n                        </li>\n                        <li data-kid=\"1-2-2-1-2-3-3\" data-name=\"customer task item 3\">\n                            Manage deliveries\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"pr-customer-actions\" data-kid=\"1-2-2-1-3\" data-name=\"customer call-to-action container\">\n                    <a class=\"pr-login-link\" data-kid=\"1-2-2-1-3-1\" data-name=\"customer login call-to-action button\" href=\"/signin/customer\">\n                        <span data-kid=\"1-2-2-1-3-1-1\" data-name=\"customer login label text\">\n                            Sign in to Customer\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right\" data-kid=\"1-2-2-1-3-1-2\" data-name=\"customer login arrow icon\">\n                        </i>\n                    </a>\n                    <div class=\"pr-create-wrap\" data-kid=\"1-2-2-1-3-2\" data-name=\"customer account registration link container\">\n                        New to PrimeRoute?\n                        <br data-kid=\"1-2-2-1-3-2-1\" data-name=\"registration link line break\"/>\n                        <a class=\"pr-create\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"customer account registration link\" href=\"/register\">\n                            Create a customer account\n                        </a>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"operations-heading\" class=\"pr-zone pr-operations-zone\" data-kid=\"1-2-2-2\" data-name=\"operations access zone section\">\n                <div class=\"pr-operations-copy\" data-kid=\"1-2-2-2-1\" data-name=\"operations copy and navigation container\">\n                    <h2 data-kid=\"1-2-2-2-1-1\" data-name=\"operations access heading\" id=\"operations-heading\">\n                        Operations access\n                    </h2>\n                    <p data-kid=\"1-2-2-2-1-2\" data-name=\"operations zone subheadline\">\n                        Choose the role you use at PrimeRoute.\n                    </p>\n                    <nav aria-label=\"Operations portals\" class=\"pr-role-list\" data-kid=\"1-2-2-2-1-3\" data-name=\"operations roles navigation menu\">\n                        <a class=\"pr-role-row\" data-kid=\"1-2-2-2-1-3-1\" data-name=\"admin role access link\" href=\"/signin/admin\" style=\"--role-accent:var(--role-admin)\">\n                            <i aria-hidden=\"true\" class=\"pr-role-glyph icon-chart-no-axes-column\" data-kid=\"1-2-2-2-1-3-1-1\" data-name=\"admin role icon\">\n                            </i>\n                            <span class=\"pr-role-detail\" data-kid=\"1-2-2-2-1-3-1-2\" data-name=\"admin role details container\">\n                                <span class=\"pr-role-name block\" data-kid=\"1-2-2-2-1-3-1-2-1\" data-name=\"admin role name text\">\n                                    Admin\n                                </span>\n                                <span class=\"pr-role-tasks block\" data-kid=\"1-2-2-2-1-3-1-2-2\" data-name=\"admin role capabilities description\">\n                                    Manage operations · Fleet & Drivers · Orders & Corridors\n                                </span>\n                            </span>\n                            <span class=\"pr-role-action\" data-kid=\"1-2-2-2-1-3-1-3\" data-name=\"admin login link action text container\">\n                                <span data-kid=\"1-2-2-2-1-3-1-3-1\" data-name=\"admin login link label\">\n                                    Sign in to Admin\n                                </span>\n                                <i aria-hidden=\"true\" class=\"icon-arrow-right\" data-kid=\"1-2-2-2-1-3-1-3-2\" data-name=\"admin login link arrow icon\">\n                                </i>\n                            </span>\n                        </a>\n                        <a class=\"pr-role-row\" data-kid=\"1-2-2-2-1-3-2\" data-name=\"warehouse role access link\" href=\"/signin/warehouse\" style=\"--role-accent:var(--role-warehouse)\">\n                            <i aria-hidden=\"true\" class=\"pr-role-glyph icon-warehouse\" data-kid=\"1-2-2-2-1-3-2-1\" data-name=\"warehouse role icon\">\n                            </i>\n                            <span class=\"pr-role-detail\" data-kid=\"1-2-2-2-1-3-2-2\" data-name=\"warehouse role details container\">\n                                <span class=\"pr-role-name block\" data-kid=\"1-2-2-2-1-3-2-2-1\" data-name=\"warehouse role name text\">\n                                    Warehouse\n                                </span>\n                                <span class=\"pr-role-tasks block\" data-kid=\"1-2-2-2-1-3-2-2-2\" data-name=\"warehouse role capabilities description\">\n                                    Inventory & Stock · Inbound & Outbound · Fleet Dispatch Console\n                                </span>\n                            </span>\n                            <span class=\"pr-role-action\" data-kid=\"1-2-2-2-1-3-2-3\" data-name=\"warehouse login link action text container\">\n                                <span data-kid=\"1-2-2-2-1-3-2-3-1\" data-name=\"warehouse login link label\">\n                                    Sign in to Warehouse\n                                </span>\n                                <i aria-hidden=\"true\" class=\"icon-arrow-right\" data-kid=\"1-2-2-2-1-3-2-3-2\" data-name=\"warehouse login link arrow icon\">\n                                </i>\n                            </span>\n                        </a>\n                        <a class=\"pr-role-row\" data-kid=\"1-2-2-2-1-3-3\" data-name=\"driver role access link\" href=\"/signin/driver\" style=\"--role-accent:var(--role-driver)\">\n                            <i aria-hidden=\"true\" class=\"pr-role-glyph icon-truck\" data-kid=\"1-2-2-2-1-3-3-1\" data-name=\"driver role icon\">\n                            </i>\n                            <span class=\"pr-role-detail\" data-kid=\"1-2-2-2-1-3-3-2\" data-name=\"driver role details container\">\n                                <span class=\"pr-role-name block\" data-kid=\"1-2-2-2-1-3-3-2-1\" data-name=\"driver role name text\">\n                                    Driver\n                                </span>\n                                <span class=\"pr-role-tasks block\" data-kid=\"1-2-2-2-1-3-3-2-2\" data-name=\"driver role capabilities description\">\n                                    Assigned Deliveries · Turn-by-Turn Route · Proof of Delivery (ePOD)\n                                </span>\n                            </span>\n                            <span class=\"pr-role-action\" data-kid=\"1-2-2-2-1-3-3-3\" data-name=\"driver login link action text container\">\n                                <span data-kid=\"1-2-2-2-1-3-3-3-1\" data-name=\"driver login link label\">\n                                    Sign in to Driver\n                                </span>\n                                <i aria-hidden=\"true\" class=\"icon-arrow-right\" data-kid=\"1-2-2-2-1-3-3-3-2\" data-name=\"driver login link arrow icon\">\n                                </i>\n                            </span>\n                        </a>\n                    </nav>\n                </div>\n                <div class=\"pr-ops-photo\" data-kid=\"1-2-2-2-2\" data-name=\"operations visual display container\">\n                    <img alt=\"PrimeRoute warehouse terminal operations\" data-kid=\"1-2-2-2-2-1\" data-name=\"operations visual image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/cargo_warehouse_terminal.jpg\"/>\n                </div>\n            </section>\n        </div>\n    </main>\n    <footer class=\"pr-auth-footer\" data-kid=\"1-3\" data-name=\"page footer bar\">\n        <span data-kid=\"1-3-1\" data-name=\"copyright notice text\">\n            © PrimeRoute Logistics Systems Inc.\n        </span>\n        <strong data-kid=\"1-3-2\" data-name=\"footer mission statement emphasis text\">\n            People · Routes · Shipments\n        </strong>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-10-06T06:30:08.639096+00:00",
      "modified": "2026-10-06T06:49:45.837425+00:00",
      "id": "var_59a92fa24e4f",
      "contentHeight": 1000
    },
    "var_a5b0ecd664ab": {
      "type": "variant",
      "label": "Sign-in · Role choice board",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.signin-font { font-family: 'Inter', system-ui, sans-serif; }\n.signin-card { min-height: 204px; }\n.signin-card-link:focus-visible { outline: 3px solid #93c5fd; outline-offset: 4px; }\n.signin-hero-photo { background-position: center 56%; }\n@media (max-width: 820px) {\n  .signin-header { padding-left: 22px !important; padding-right: 22px !important; }\n  .signin-main { padding-left: 22px !important; padding-right: 22px !important; }\n  .signin-intro { grid-template-columns: 1fr !important; gap: 22px !important; }\n  .signin-hero-photo { min-height: 112px !important; }\n  .signin-grid { grid-template-columns: 1fr !important; }\n  .signin-card { min-height: 0; padding: 20px !important; }\n  .signin-task-list { gap: 5px !important; }\n}\n@media (max-width: 480px) {\n  .signin-header { height: 72px; }\n  .signin-home-link span { display: none; }\n  .signin-main { padding-top: 30px !important; }\n  .signin-h1 { font-size: 31px !important; }\n  .signin-card { padding: 18px !important; }\n  .signin-card-title { font-size: 16px !important; }\n  .signin-task-list { font-size: 12.5px !important; }\n}\n.signin-theme{position:relative;isolation:isolate;overflow:hidden;background-color:#f3f7fc}\n.signin-theme:before{content:\"\";position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(rgba(59,130,246,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(59,130,246,.045) 1px,transparent 1px),radial-gradient(ellipse at 50% 28%,rgba(219,234,254,.62),transparent 62%);background-size:52px 52px,52px 52px,auto}\n.signin-theme>header,.signin-theme>main,.signin-theme>footer{position:relative;z-index:1}\n.signin-float-layer{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}\n.signin-float{position:absolute;display:block;overflow:hidden;border:2px solid rgba(255,255,255,.8);border-radius:14px;opacity:.28;box-shadow:0 8px 22px rgba(15,23,42,.12);will-change:transform}\n.signin-float img{display:block;width:100%;height:100%;object-fit:cover}\n.signin-float--truck{left:-58px;top:29%;width:132px;height:86px;transform:rotate(-8deg)}\n.signin-float--warehouse{right:-62px;bottom:18%;width:142px;height:94px;transform:rotate(7deg)}\n@media(max-width:768px){.signin-float-layer{display:none}}\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    (() => {\n  if (!window.gsap) return;\n  const motion = gsap.matchMedia();\n  motion.add(\"(prefers-reduced-motion: no-preference)\", () => {\n    gsap.to(\".signin-float--truck\", { x: 22, y: -12, rotation: -3, duration: 13, ease: \"sine.inOut\", repeat: -1, yoyo: true });\n    gsap.to(\".signin-float--warehouse\", { x: -20, y: 12, rotation: 4, duration: 16, ease: \"sine.inOut\", repeat: -1, yoyo: true });\n  });\n})();\n</script>\n<div class=\"signin-font signin-theme min-h-screen bg-[#f3f7fc] text-[#0f172a]\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"signin-float-layer\" data-kid=\"1-3\" data-name=\"decorative float layer container\">\n        <div class=\"signin-float signin-float--truck\" data-dynamic=\"true\" data-kid=\"1-3-1\" data-name=\"truck float element\" data-reason=\"animated by GSAP looping motion\">\n            <img alt=\"\" data-kid=\"1-3-1-1\" data-name=\"truck float image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero_real_highway_truck.jpg\"/>\n        </div>\n        <div class=\"signin-float signin-float--warehouse\" data-dynamic=\"true\" data-kid=\"1-3-2\" data-name=\"warehouse float element\" data-reason=\"animated by GSAP looping motion\">\n            <img alt=\"\" data-kid=\"1-3-2-1\" data-name=\"warehouse float image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/cargo_warehouse_terminal.jpg\"/>\n        </div>\n    </div>\n    <header class=\"signin-header mx-auto flex h-[82px] max-w-[1320px] items-center justify-between px-8\" data-kid=\"1-1\" data-name=\"header navigation section\">\n        <a aria-label=\"PrimeRoute Logistics home\" class=\"flex items-center gap-3 no-underline\" data-kid=\"1-1-1\" data-name=\"home link logo\" href=\"/\">\n            <span class=\"flex h-[42px] w-[42px] items-center justify-center rounded-[12px] bg-gradient-to-br from-[#2563eb] to-[#1d4ed8] text-[16px] font-extrabold tracking-[-0.04em] text-white shadow-[0_5px_14px_rgba(37,99,235,0.23)]\" data-kid=\"1-1-1-1\" data-name=\"brand initials box\">\n                PR\n            </span>\n            <span class=\"flex flex-col leading-tight\" data-kid=\"1-1-1-2\" data-name=\"brand name text group\">\n                <span class=\"text-[18px] font-extrabold tracking-[-0.035em] text-[#0f172a]\" data-kid=\"1-1-1-2-1\" data-name=\"brand name headline\">\n                    PrimeRoute\n                </span>\n                <span class=\"mt-[3px] text-[10px] font-bold uppercase tracking-[0.14em] text-[#2563eb]\" data-kid=\"1-1-1-2-2\" data-name=\"brand industry tag\">\n                    Logistics\n                </span>\n            </span>\n        </a>\n        <a class=\"signin-home-link inline-flex items-center gap-2 rounded-[9px] border border-[#d7e0ec] bg-white px-[15px] py-[10px] text-[13px] font-semibold text-[#334155] no-underline shadow-[0_1px_2px_rgba(15,23,42,0.03)]\" data-kid=\"1-1-2\" data-name=\"back to home button\" href=\"/\">\n            <i aria-hidden=\"true\" class=\"icon-arrow-left text-[15px]\" data-kid=\"1-1-2-1\" data-name=\"left arrow icon\">\n            </i>\n            <span data-kid=\"1-1-2-2\" data-name=\"back to home label\">\n                Back to Home\n            </span>\n        </a>\n    </header>\n    <main class=\"signin-main mx-auto max-w-[1184px] px-8 pb-8 pt-[38px]\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section class=\"signin-intro mb-[26px] grid grid-cols-[minmax(0,1fr)_350px] items-center gap-10\" data-kid=\"1-2-1\" data-name=\"introduction section\">\n            <div class=\"max-w-[640px]\" data-kid=\"1-2-1-1\" data-name=\"intro text container\">\n                <h1 class=\"signin-h1 m-0 text-[38px] font-bold leading-[1.14] tracking-[-0.045em] text-[#111c30]\" data-kid=\"1-2-1-1-1\" data-name=\"intro page headline\">\n                    Choose the portal for your work.\n                </h1>\n                <p class=\"mt-[12px] max-w-[590px] text-[15px] leading-[1.65] text-[#526176]\" data-kid=\"1-2-1-1-2\" data-name=\"intro description paragraph\">\n                    Select your PrimeRoute workspace to book, manage, dispatch, or deliver freight.\n                </p>\n            </div>\n            <div class=\"signin-hero-photo h-[116px] overflow-hidden rounded-[12px] bg-[#d9e4ef] ring-1 ring-inset ring-[#d7e0ec]\" data-kid=\"1-2-1-2\" data-name=\"hero image container\">\n                <img alt=\"PrimeRoute freight truck travelling near a port\" class=\"h-full w-full object-cover\" data-kid=\"1-2-1-2-1\" data-name=\"freight truck photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero_real_highway_truck.jpg\"/>\n            </div>\n        </section>\n        <section aria-label=\"Choose a PrimeRoute portal\" class=\"signin-grid grid grid-cols-2 gap-[16px]\" data-kid=\"1-2-2\" data-name=\"portals grid container\">\n            <article class=\"signin-card flex flex-col rounded-[16px] border border-[#dce4ee] bg-white p-[24px] shadow-[0_2px_5px_rgba(15,23,42,0.035)]\" data-kid=\"1-2-2-1\" data-name=\"customer portal card\">\n                <div class=\"flex items-center gap-[11px]\" data-kid=\"1-2-2-1-1\" data-name=\"customer portal header group\">\n                    <i aria-hidden=\"true\" class=\"icon-package text-[21px] text-[#e87324]\" data-kid=\"1-2-2-1-1-1\" data-name=\"package icon\">\n                    </i>\n                    <h2 class=\"signin-card-title m-0 text-[17px] font-bold tracking-[-0.02em] text-[#172033]\" data-kid=\"1-2-2-1-1-2\" data-name=\"customer portal title\">\n                        Customer Portal\n                    </h2>\n                </div>\n                <p class=\"mt-[17px] mb-0 text-[18px] font-semibold leading-snug tracking-[-0.02em] text-[#243248]\" data-kid=\"1-2-2-1-2\" data-name=\"customer portal action summary\">\n                    Book shipments\n                </p>\n                <p class=\"signin-task-list mt-[7px] mb-0 flex flex-wrap items-center gap-[8px] text-[13px] leading-[1.5] text-[#66758a]\" data-kid=\"1-2-2-1-3\" data-name=\"customer portal task list\">\n                    <span data-kid=\"1-2-2-1-3-1\" data-name=\"customer portal task one\">\n                        Track orders\n                    </span>\n                    <span class=\"text-[#c4cdd8]\" data-kid=\"1-2-2-1-3-2\" data-name=\"task separator dot\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-2-1-3-3\" data-name=\"customer portal task two\">\n                        Manage deliveries\n                    </span>\n                </p>\n                <div class=\"mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-[#eef1f5] pt-[15px]\" data-kid=\"1-2-2-1-4\" data-name=\"customer portal footer area\">\n                    <a class=\"signin-card-link inline-flex items-center gap-[8px] text-[13.5px] font-bold text-[#b85816] no-underline\" data-kid=\"1-2-2-1-4-1\" data-name=\"sign in to customer link\" href=\"/signin/customer\">\n                        Sign in to Customer\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right text-[15px]\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"right arrow icon\">\n                        </i>\n                    </a>\n                    <span class=\"text-[12px] text-[#708095]\" data-kid=\"1-2-2-1-4-2\" data-name=\"new customer account container\">\n                        New?\n                        <a class=\"font-semibold text-[#334155] underline decoration-[#c4cfdb] underline-offset-2\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"create customer account link\" href=\"/register\">\n                            Create a customer account\n                        </a>\n                    </span>\n                </div>\n            </article>\n            <article class=\"signin-card flex flex-col rounded-[16px] border border-[#dce4ee] bg-white p-[24px] shadow-[0_2px_5px_rgba(15,23,42,0.035)]\" data-kid=\"1-2-2-2\" data-name=\"admin portal card\">\n                <div class=\"flex items-center gap-[11px]\" data-kid=\"1-2-2-2-1\" data-name=\"admin portal header group\">\n                    <i aria-hidden=\"true\" class=\"icon-chart-no-axes-combined text-[21px] text-[#6d3df5]\" data-kid=\"1-2-2-2-1-1\" data-name=\"chart icon\">\n                    </i>\n                    <h2 class=\"signin-card-title m-0 text-[17px] font-bold tracking-[-0.02em] text-[#172033]\" data-kid=\"1-2-2-2-1-2\" data-name=\"admin portal title\">\n                        Admin Portal\n                    </h2>\n                </div>\n                <p class=\"mt-[17px] mb-0 text-[18px] font-semibold leading-snug tracking-[-0.02em] text-[#243248]\" data-kid=\"1-2-2-2-2\" data-name=\"admin portal action summary\">\n                    Fleet & Drivers\n                </p>\n                <p class=\"signin-task-list mt-[7px] mb-0 flex flex-wrap items-center gap-[8px] text-[13px] leading-[1.5] text-[#66758a]\" data-kid=\"1-2-2-2-3\" data-name=\"admin portal task list\">\n                    <span data-kid=\"1-2-2-2-3-1\" data-name=\"admin portal task one\">\n                        Manage operations\n                    </span>\n                    <span class=\"text-[#c4cdd8]\" data-kid=\"1-2-2-2-3-2\" data-name=\"task separator dot\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-2-2-3-3\" data-name=\"admin portal task two\">\n                        Orders & Corridors\n                    </span>\n                </p>\n                <div class=\"mt-auto border-t border-[#eef1f5] pt-[15px]\" data-kid=\"1-2-2-2-4\" data-name=\"admin portal footer area\">\n                    <a class=\"signin-card-link inline-flex items-center gap-[8px] text-[13.5px] font-bold text-[#5b36cf] no-underline\" data-kid=\"1-2-2-2-4-1\" data-name=\"sign in to admin link\" href=\"/signin/admin\">\n                        Sign in to Admin\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right text-[15px]\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"right arrow icon\">\n                        </i>\n                    </a>\n                </div>\n            </article>\n            <article class=\"signin-card flex flex-col rounded-[16px] border border-[#dce4ee] bg-white p-[24px] shadow-[0_2px_5px_rgba(15,23,42,0.035)]\" data-kid=\"1-2-2-3\" data-name=\"warehouse portal card\">\n                <div class=\"flex items-center gap-[11px]\" data-kid=\"1-2-2-3-1\" data-name=\"warehouse portal header group\">\n                    <i aria-hidden=\"true\" class=\"icon-warehouse text-[21px] text-[#0a9a6c]\" data-kid=\"1-2-2-3-1-1\" data-name=\"warehouse icon\">\n                    </i>\n                    <h2 class=\"signin-card-title m-0 text-[17px] font-bold tracking-[-0.02em] text-[#172033]\" data-kid=\"1-2-2-3-1-2\" data-name=\"warehouse portal title\">\n                        Warehouse Portal\n                    </h2>\n                </div>\n                <p class=\"mt-[17px] mb-0 text-[18px] font-semibold leading-snug tracking-[-0.02em] text-[#243248]\" data-kid=\"1-2-2-3-2\" data-name=\"warehouse portal action summary\">\n                    Inbound & Outbound\n                </p>\n                <p class=\"signin-task-list mt-[7px] mb-0 flex flex-wrap items-center gap-[8px] text-[13px] leading-[1.5] text-[#66758a]\" data-kid=\"1-2-2-3-3\" data-name=\"warehouse portal task list\">\n                    <span data-kid=\"1-2-2-3-3-1\" data-name=\"warehouse portal task one\">\n                        Inventory & Stock\n                    </span>\n                    <span class=\"text-[#c4cdd8]\" data-kid=\"1-2-2-3-3-2\" data-name=\"task separator dot\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-2-3-3-3\" data-name=\"warehouse portal task two\">\n                        Fleet Dispatch Console\n                    </span>\n                </p>\n                <div class=\"mt-auto border-t border-[#eef1f5] pt-[15px]\" data-kid=\"1-2-2-3-4\" data-name=\"warehouse portal footer area\">\n                    <a class=\"signin-card-link inline-flex items-center gap-[8px] text-[13.5px] font-bold text-[#087c59] no-underline\" data-kid=\"1-2-2-3-4-1\" data-name=\"sign in to warehouse link\" href=\"/signin/warehouse\">\n                        Sign in to Warehouse\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right text-[15px]\" data-kid=\"1-2-2-3-4-1-1\" data-name=\"right arrow icon\">\n                        </i>\n                    </a>\n                </div>\n            </article>\n            <article class=\"signin-card flex flex-col rounded-[16px] border border-[#dce4ee] bg-white p-[24px] shadow-[0_2px_5px_rgba(15,23,42,0.035)]\" data-kid=\"1-2-2-4\" data-name=\"driver portal card\">\n                <div class=\"flex items-center gap-[11px]\" data-kid=\"1-2-2-4-1\" data-name=\"driver portal header group\">\n                    <i aria-hidden=\"true\" class=\"icon-truck text-[21px] text-[#2563eb]\" data-kid=\"1-2-2-4-1-1\" data-name=\"truck icon\">\n                    </i>\n                    <h2 class=\"signin-card-title m-0 text-[17px] font-bold tracking-[-0.02em] text-[#172033]\" data-kid=\"1-2-2-4-1-2\" data-name=\"driver portal title\">\n                        Driver Portal\n                    </h2>\n                </div>\n                <p class=\"mt-[17px] mb-0 text-[18px] font-semibold leading-snug tracking-[-0.02em] text-[#243248]\" data-kid=\"1-2-2-4-2\" data-name=\"driver portal action summary\">\n                    Assigned Deliveries\n                </p>\n                <p class=\"signin-task-list mt-[7px] mb-0 flex flex-wrap items-center gap-[8px] text-[13px] leading-[1.5] text-[#66758a]\" data-kid=\"1-2-2-4-3\" data-name=\"driver portal task list\">\n                    <span data-kid=\"1-2-2-4-3-1\" data-name=\"driver portal task one\">\n                        Turn-by-Turn Route\n                    </span>\n                    <span class=\"text-[#c4cdd8]\" data-kid=\"1-2-2-4-3-2\" data-name=\"task separator dot\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-2-4-3-3\" data-name=\"driver portal task two\">\n                        Proof of Delivery (ePOD)\n                    </span>\n                </p>\n                <div class=\"mt-auto border-t border-[#eef1f5] pt-[15px]\" data-kid=\"1-2-2-4-4\" data-name=\"driver portal footer area\">\n                    <a class=\"signin-card-link inline-flex items-center gap-[8px] text-[13.5px] font-bold text-[#1d4ed8] no-underline\" data-kid=\"1-2-2-4-4-1\" data-name=\"sign in to driver link\" href=\"/signin/driver\">\n                        Sign in to Driver\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right text-[15px]\" data-kid=\"1-2-2-4-4-1-1\" data-name=\"right arrow icon\">\n                        </i>\n                    </a>\n                </div>\n            </article>\n        </section>\n        <footer class=\"mt-[22px] flex items-center justify-between border-t border-[#dfe6ef] pt-[16px] text-[12px] text-[#738197]\" data-kid=\"1-2-3\" data-name=\"page footer section\">\n            <span data-kid=\"1-2-3-1\" data-name=\"company copyright text\">\n                PrimeRoute Logistics\n            </span>\n            <span class=\"hidden sm:inline\" data-kid=\"1-2-3-2\" data-name=\"company tagline text\">\n                Connected Logistics. Smarter Tomorrow.\n            </span>\n        </footer>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-06T06:30:12.132889+00:00",
      "modified": "2026-10-06T06:49:34.148290+00:00",
      "id": "var_a5b0ecd664ab",
      "contentHeight": 1000
    }
  },
  "comments": [],
  "nextCommentNumber": 1
}