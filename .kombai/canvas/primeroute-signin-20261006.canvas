        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.signin-theme{position:relative;isolation:isolate;overflow:hidden;background-color:#f3f7fc}\n.signin-theme:before{content:\"\";position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(rgba(59,130,246,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(59,130,246,.045) 1px,transparent 1px),radial-gradient(ellipse at 50% 28%,rgba(219,234,254,.62),transparent 62%);background-size:52px 52px,52px 52px,auto}\n.signin-theme>header,.signin-theme>main,.signin-theme>footer{position:relative;z-index:1}\n.signin-float-layer{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}\n.signin-float{position:absolute;display:block;overflow:hidden;border:2px solid rgba(255,255,255,.8);border-radius:14px;opacity:.28;box-shadow:0 8px 22px rgba(15,23,42,.12);will-change:transform}\n.signin-float img{display:block;width:100%;height:100%;object-fit:cover}\n.signin-float--truck{left:-58px;top:29%;width:132px;height:86px;transform:rotate(-8deg)}\n.signin-float--warehouse{right:-62px;bottom:18%;width:142px;height:94px;transform:rotate(7deg)}\n@media(max-width:768px){.signin-float-layer{display:none}}\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    (() => {\n  if (!window.gsap) return;\n  const motion = gsap.matchMedia();\n  motion.add(\"(prefers-reduced-motion: no-preference)\", () => {\n    gsap.to(\".signin-float--truck\", { x: 22, y: -12, rotation: -3, duration: 13, ease: \"sine.inOut\", repeat: -1, yoyo: true });\n    gsap.to(\".signin-float--warehouse\", { x: -20, y: 12, rotation: 4, duration: 16, ease: \"sine.inOut\", repeat: -1, yoyo: true });\n  });\n})();\n</script>\n<div class=\"min-h-screen bg-[#f3f7fc] text-[#0f172a] signin-theme\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: 'Inter', sans-serif;\">\n    <div aria-hidden=\"true\" class=\"signin-float-layer\" data-kid=\"1-4\" data-name=\"floating background elements container\">\n        <div class=\"signin-float signin-float--truck\" data-dynamic=\"true\" data-kid=\"1-4-1\" data-name=\"truck image float container\" data-reason=\"animated via GSAP script\">\n            <img alt=\"\" data-kid=\"1-4-1-1\" data-name=\"truck float image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero_real_highway_truck.jpg\"/>\n        </div>\n        <div class=\"signin-float signin-float--warehouse\" data-dynamic=\"true\" data-kid=\"1-4-2\" data-name=\"warehouse image float container\" data-reason=\"animated via GSAP script\">\n            <img alt=\"\" data-kid=\"1-4-2-1\" data-name=\"warehouse float image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/cargo_warehouse_terminal.jpg\"/>\n        </div>\n    </div>\n    <header class=\"mx-auto flex w-full max-w-[1280px] items-center justify-between px-8 py-7 max-md:px-5 max-md:py-5\" data-kid=\"1-1\" data-name=\"header container\">\n        <a aria-label=\"PrimeRoute Logistics home\" class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand logo and name link\" href=\"/\">\n            <span class=\"flex h-11 w-11 items-center justify-center rounded-[13px] bg-[#1d4ed8] text-[16px] font-extrabold tracking-[-0.04em] text-white shadow-[0_5px_14px_rgba(37,99,235,0.22)]\" data-kid=\"1-1-1-1\" data-name=\"brand logo icon\">\n                PR\n            </span>\n            <span class=\"flex flex-col\" data-kid=\"1-1-1-2\" data-name=\"brand name container\">\n                <span class=\"text-[18px] font-extrabold leading-tight tracking-[-0.04em] text-[#0f172a]\" data-kid=\"1-1-1-2-1\" data-name=\"brand name\">\n                    PrimeRoute\n                </span>\n                <span class=\"mt-0.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[#2563eb]\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle\">\n                    Logistics\n                </span>\n            </span>\n        </a>\n        <div class=\"flex items-center gap-8 max-sm:gap-3\" data-kid=\"1-1-2\" data-name=\"header action container\">\n            <span class=\"text-[12px] font-semibold uppercase tracking-[0.11em] text-[#64748b] max-sm:hidden\" data-kid=\"1-1-2-1\" data-name=\"header slogan text\">\n                Connected logistics. Smarter tomorrow.\n            </span>\n            <a class=\"inline-flex items-center gap-2 rounded-lg border border-[#dbe3ee] bg-white px-4 py-2.5 text-[13px] font-semibold text-[#334155] hover:border-[#94a3b8] hover:text-[#0f172a]\" data-kid=\"1-1-2-2\" data-name=\"back to home button\" href=\"/\">\n                <i aria-hidden=\"true\" class=\"icon-arrow-left text-[15px]\" data-kid=\"1-1-2-2-1\" data-name=\"back arrow icon\" style=\"width:15px;height:15px;color:currentColor\">\n                </i>\n                Back to Home\n            </a>\n        </div>\n    </header>\n    <main class=\"mx-auto grid w-full max-w-[1280px] grid-cols-[minmax(0,1fr)_370px] items-center gap-[76px] px-8 pb-14 pt-10 max-lg:grid-cols-[minmax(0,1fr)_320px] max-lg:gap-10 max-md:grid-cols-1 max-md:gap-8 max-md:px-5 max-md:pt-6\" data-kid=\"1-2\" data-name=\"workspace selection main content grid\">\n        <section aria-labelledby=\"workspace-heading\" class=\"min-w-0\" data-kid=\"1-2-1\" data-name=\"workspace selection section\">\n            <div class=\"mb-8 max-w-[660px]\" data-kid=\"1-2-1-1\" data-name=\"section header container\">\n                <h1 class=\"text-[38px] font-bold leading-[1.14] tracking-[-0.045em] text-[#0f172a] max-sm:text-[30px]\" data-kid=\"1-2-1-1-1\" data-name=\"workspace selection heading\" id=\"workspace-heading\">\n                    Choose your workspace\n                </h1>\n                <p class=\"mt-3 text-[16px] leading-7 text-[#64748b]\" data-kid=\"1-2-1-1-2\" data-name=\"workspace selection description\">\n                    Sign in to the workspace for your role.\n                </p>\n            </div>\n            <div class=\"border-t border-[#dce4ee]\" data-kid=\"1-2-1-2\" data-name=\"workspace cards container\">\n                <div class=\"grid grid-cols-[166px_minmax(0,1fr)_142px] items-center gap-5 border-b border-[#dce4ee] py-[22px] max-md:grid-cols-[minmax(0,1fr)_auto] max-md:gap-x-4 max-md:gap-y-2 max-md:py-[18px]\" data-kid=\"1-2-1-2-1\" data-name=\"customer workspace card\">\n                    <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"1-2-1-2-1-1\" data-name=\"customer icon and title container\">\n                        <i aria-hidden=\"true\" class=\"icon-package mt-0.5 shrink-0 text-[20px]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"customer icon\" style=\"width:20px;height:20px;color:#f97316\">\n                        </i>\n                        <div class=\"min-w-0\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"customer title link container\">\n                            <h2 class=\"text-[15px] font-bold tracking-[-0.015em] text-[#172033]\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"customer role title\">\n                                Customer\n                            </h2>\n                            <a class=\"mt-1.5 inline-block text-[12px] font-semibold text-[#c2410c] underline decoration-[#fed7aa] underline-offset-4 hover:text-[#9a3412]\" data-kid=\"1-2-1-2-1-1-2-2\" data-name=\"create customer account link\" href=\"/register\">\n                                Create a customer account\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[13px] leading-5 text-[#475569] max-md:col-span-2 max-md:row-start-2 max-md:gap-x-3 max-sm:text-[12px]\" data-kid=\"1-2-1-2-1-2\" data-name=\"customer features list\">\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"customer feature 1\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#f97316]\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"customer feature bullet 1\">\n                            </span>\n                            Book shipments\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"customer feature 2\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#f97316]\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"customer feature bullet 2\">\n                            </span>\n                            Track orders\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-1-2-3\" data-name=\"customer feature 3\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#f97316]\" data-kid=\"1-2-1-2-1-2-3-1\" data-name=\"customer feature bullet 3\">\n                            </span>\n                            Manage deliveries\n                        </span>\n                    </div>\n                    <a class=\"group inline-flex items-center justify-end gap-2 whitespace-nowrap text-[13px] font-semibold text-[#c2410c] hover:text-[#9a3412] max-md:col-start-2 max-md:row-start-1 max-md:text-[12px]\" data-kid=\"1-2-1-2-1-3\" data-name=\"sign in to customer account button\" href=\"/signin/customer\">\n                        <span data-kid=\"1-2-1-2-1-3-1\" data-name=\"button text\">\n                            Sign in to Customer\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right text-[15px] transition-transform group-hover:translate-x-0.5\" data-kid=\"1-2-1-2-1-3-2\" data-name=\"right arrow icon\" style=\"width:15px;height:15px;color:currentColor\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"grid grid-cols-[166px_minmax(0,1fr)_142px] items-center gap-5 border-b border-[#dce4ee] py-[22px] max-md:grid-cols-[minmax(0,1fr)_auto] max-md:gap-x-4 max-md:gap-y-2 max-md:py-[18px]\" data-kid=\"1-2-1-2-2\" data-name=\"admin workspace card\">\n                    <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-1-2-2-1\" data-name=\"admin icon and title container\">\n                        <i aria-hidden=\"true\" class=\"icon-chart-no-axes-combined shrink-0 text-[20px]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"admin icon\" style=\"width:20px;height:20px;color:#6d3df5\">\n                        </i>\n                        <h2 class=\"text-[15px] font-bold tracking-[-0.015em] text-[#172033]\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"admin role title\">\n                            Admin\n                        </h2>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[13px] leading-5 text-[#475569] max-md:col-span-2 max-md:row-start-2 max-md:gap-x-3 max-sm:text-[12px]\" data-kid=\"1-2-1-2-2-2\" data-name=\"admin features list\">\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"admin feature 1\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#6d3df5]\" data-kid=\"1-2-1-2-2-2-1-1\" data-name=\"admin feature bullet 1\">\n                            </span>\n                            Manage operations\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"admin feature 2\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#6d3df5]\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"admin feature bullet 2\">\n                            </span>\n                            Fleet & Drivers\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"admin feature 3\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#6d3df5]\" data-kid=\"1-2-1-2-2-2-3-1\" data-name=\"admin feature bullet 3\">\n                            </span>\n                            Orders & Corridors\n                        </span>\n                    </div>\n                    <a class=\"group inline-flex items-center justify-end gap-2 whitespace-nowrap text-[13px] font-semibold text-[#5b2fe3] hover:text-[#4a21d4] max-md:col-start-2 max-md:row-start-1 max-md:text-[12px]\" data-kid=\"1-2-1-2-2-3\" data-name=\"sign in to admin account button\" href=\"/signin/admin\">\n                        <span data-kid=\"1-2-1-2-2-3-1\" data-name=\"button text\">\n                            Sign in to Admin\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right text-[15px] transition-transform group-hover:translate-x-0.5\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"right arrow icon\" style=\"width:15px;height:15px;color:currentColor\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"grid grid-cols-[166px_minmax(0,1fr)_142px] items-center gap-5 border-b border-[#dce4ee] py-[22px] max-md:grid-cols-[minmax(0,1fr)_auto] max-md:gap-x-4 max-md:gap-y-2 max-md:py-[18px]\" data-kid=\"1-2-1-2-3\" data-name=\"warehouse workspace card\">\n                    <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-1-2-3-1\" data-name=\"warehouse icon and title container\">\n                        <i aria-hidden=\"true\" class=\"icon-warehouse shrink-0 text-[20px]\" data-kid=\"1-2-1-2-3-1-1\" data-name=\"warehouse icon\" style=\"width:20px;height:20px;color:#059669\">\n                        </i>\n                        <h2 class=\"text-[15px] font-bold tracking-[-0.015em] text-[#172033]\" data-kid=\"1-2-1-2-3-1-2\" data-name=\"warehouse role title\">\n                            Warehouse\n                        </h2>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[13px] leading-5 text-[#475569] max-md:col-span-2 max-md:row-start-2 max-md:gap-x-3 max-sm:text-[12px]\" data-kid=\"1-2-1-2-3-2\" data-name=\"warehouse features list\">\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-3-2-1\" data-name=\"warehouse feature 1\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#10b981]\" data-kid=\"1-2-1-2-3-2-1-1\" data-name=\"warehouse feature bullet 1\">\n                            </span>\n                            Inventory & Stock\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-3-2-2\" data-name=\"warehouse feature 2\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#10b981]\" data-kid=\"1-2-1-2-3-2-2-1\" data-name=\"warehouse feature bullet 2\">\n                            </span>\n                            Inbound & Outbound\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-3-2-3\" data-name=\"warehouse feature 3\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#10b981]\" data-kid=\"1-2-1-2-3-2-3-1\" data-name=\"warehouse feature bullet 3\">\n                            </span>\n                            Fleet Dispatch Console\n                        </span>\n                    </div>\n                    <a class=\"group inline-flex items-center justify-end gap-2 whitespace-nowrap text-[13px] font-semibold text-[#047857] hover:text-[#065f46] max-md:col-start-2 max-md:row-start-1 max-md:text-[12px]\" data-kid=\"1-2-1-2-3-3\" data-name=\"sign in to warehouse account button\" href=\"/signin/warehouse\">\n                        <span data-kid=\"1-2-1-2-3-3-1\" data-name=\"button text\">\n                            Sign in to Warehouse\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right text-[15px] transition-transform group-hover:translate-x-0.5\" data-kid=\"1-2-1-2-3-3-2\" data-name=\"right arrow icon\" style=\"width:15px;height:15px;color:currentColor\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"grid grid-cols-[166px_minmax(0,1fr)_142px] items-center gap-5 border-b border-[#dce4ee] py-[22px] max-md:grid-cols-[minmax(0,1fr)_auto] max-md:gap-x-4 max-md:gap-y-2 max-md:py-[18px]\" data-kid=\"1-2-1-2-4\" data-name=\"driver workspace card\">\n                    <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-1-2-4-1\" data-name=\"driver icon and title container\">\n                        <i aria-hidden=\"true\" class=\"icon-truck shrink-0 text-[20px]\" data-kid=\"1-2-1-2-4-1-1\" data-name=\"driver icon\" style=\"width:20px;height:20px;color:#2563eb\">\n                        </i>\n                        <h2 class=\"text-[15px] font-bold tracking-[-0.015em] text-[#172033]\" data-kid=\"1-2-1-2-4-1-2\" data-name=\"driver role title\">\n                            Driver\n                        </h2>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[13px] leading-5 text-[#475569] max-md:col-span-2 max-md:row-start-2 max-md:gap-x-3 max-sm:text-[12px]\" data-kid=\"1-2-1-2-4-2\" data-name=\"driver features list\">\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-4-2-1\" data-name=\"driver feature 1\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#2563eb]\" data-kid=\"1-2-1-2-4-2-1-1\" data-name=\"driver feature bullet 1\">\n                            </span>\n                            Assigned Deliveries\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-4-2-2\" data-name=\"driver feature 2\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#2563eb]\" data-kid=\"1-2-1-2-4-2-2-1\" data-name=\"driver feature bullet 2\">\n                            </span>\n                            Turn-by-Turn Route\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-2-4-2-3\" data-name=\"driver feature 3\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#2563eb]\" data-kid=\"1-2-1-2-4-2-3-1\" data-name=\"driver feature bullet 3\">\n                            </span>\n                            Proof of Delivery (ePOD)\n                        </span>\n                    </div>\n                    <a class=\"group inline-flex items-center justify-end gap-2 whitespace-nowrap text-[13px] font-semibold text-[#1d4ed8] hover:text-[#1e40af] max-md:col-start-2 max-md:row-start-1 max-md:text-[12px]\" data-kid=\"1-2-1-2-4-3\" data-name=\"sign in to driver account button\" href=\"/signin/driver\">\n                        <span data-kid=\"1-2-1-2-4-3-1\" data-name=\"button text\">\n                            Sign in to Driver\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right text-[15px] transition-transform group-hover:translate-x-0.5\" data-kid=\"1-2-1-2-4-3-2\" data-name=\"right arrow icon\" style=\"width:15px;height:15px;color:currentColor\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <aside class=\"max-md:order-first max-md:mt-1\" data-kid=\"1-2-2\" data-name=\"aside promotional content area\">\n            <div class=\"relative h-[520px] overflow-hidden rounded-[16px] bg-[#e7edf4] max-lg:h-[470px] max-md:h-[220px] max-sm:h-[170px]\" data-kid=\"1-2-2-1\" data-name=\"promotional image container\">\n                <img alt=\"Warehouse operations with shelving and loading bays\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-2-2-1-1\" data-name=\"warehouse operations image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/cargo_warehouse_terminal.jpg\"/>\n                <div class=\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0b1220]/75 via-[#0b1220]/25 to-transparent px-7 pb-7 pt-16 max-md:px-5 max-md:pb-4 max-md:pt-10\" data-kid=\"1-2-2-1-2\" data-name=\"image gradient overlay container\">\n                    <p class=\"max-w-[290px] text-[19px] font-semibold leading-7 tracking-[-0.02em] text-white max-md:text-[16px] max-md:leading-5\" data-kid=\"1-2-2-1-2-1\" data-name=\"promotional slogan text\">\n                        Connected logistics. Smarter tomorrow.\n                    </p>\n                </div>\n            </div>\n            <p class=\"mt-4 max-w-[340px] text-[13px] leading-6 text-[#64748b] max-md:hidden\" data-kid=\"1-2-2-2\" data-name=\"promotional description text\">\n                Choose the portal that matches your work. Your tasks stay in the right hands from the first shipment to the final delivery.\n            </p>\n        </aside>\n    </main>\n    <footer class=\"mx-auto flex w-full max-w-[1280px] items-center justify-between border-t border-[#e2e8f0] px-8 py-5 text-[12px] text-[#64748b] max-md:px-5 max-sm:flex-col max-sm:items-start max-sm:gap-2\" data-kid=\"1-3\" data-name=\"footer section\">\n        <span data-kid=\"1-3-1\" data-name=\"copyright notice\">\n            © 2026 PrimeRoute Logistics\n        </span>\n        <span data-kid=\"1-3-2\" data-name=\"footer tagline\">\n            Moving businesses forward\n        </span>\n    </footer>\n</div>\n",
